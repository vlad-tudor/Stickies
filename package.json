{
  "name": "stickies",
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run test:unit && bun run test:idb",
    "relay": "HOST=localhost PORT=1234 y-websocket-server",
    "build": "bun run typecheck && bun run lint && vite build",
    "preview": "vite preview",
    "test:idb": "bun test --conditions=browser --preload ./src/test/setup-idb.ts src/stores/board/docPersistence.idb.test.ts",
    "test:unit": "bun test --conditions=browser --path-ignore-patterns=\"**/*.idb.test.ts\""
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tiptap/core": "^2",
    "@tiptap/extension-collaboration": "^2",
    "@tiptap/extension-collaboration-cursor": "^2",
    "@tiptap/extension-link": "^2",
    "@tiptap/extension-table": "^2",
    "@tiptap/extension-table-cell": "^2",
    "@tiptap/extension-table-header": "^2",
    "@tiptap/extension-table-row": "^2",
    "@tiptap/extension-underline": "^2",
    "@tiptap/pm": "^2",
    "@tiptap/starter-kit": "^2",
    "animejs": "^4.5.0",
    "dompurify": "^3.4.12",
    "lucide-static": "^1.7.0",
    "lz-string": "^1.5.0",
    "marked": "^17.0.5",
    "solid-js": "^1.9.1",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "3.0.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "^1.3.14",
    "@types/lz-string": "^1.5.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.14.5",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "sass": "^1.79.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.0",
    "ws": "^8.21.0",
    "y-websocket-legacy": "npm:y-websocket@1.5.4"
  }
}
